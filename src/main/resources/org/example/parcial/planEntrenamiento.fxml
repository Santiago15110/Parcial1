<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="642.0" prefWidth="947.0" style="-fx-background-color: #f2f2f0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial.viewController.PlanEntrenamientoViewController">


    <Button onAction="#handleRegresar" text="&lt;- Regresar" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0" />

    <!-- Titulo -->
    <Label layoutX="27.0" layoutY="76.0" style="-fx-font-size: 28px;" text="Gestionar planes de entrenamiento" AnchorPane.leftAnchor="27.0" AnchorPane.topAnchor="76.0">
      <font>
         <Font size="18.0" />
      </font></Label>


    <Label layoutX="30.0" layoutY="160.0" text="Codigo" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="160.0" />
    <TextField fx:id="txtCodigo" layoutX="30.0" layoutY="183.0" prefHeight="25.0" prefWidth="194.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="183.0" />

    <Label layoutX="27.0" layoutY="244.0" text="Nombre" AnchorPane.leftAnchor="27.0" AnchorPane.topAnchor="244.0" />
    <TextField fx:id="txtNombre" layoutX="30.0" layoutY="269.0" prefHeight="25.0" prefWidth="194.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="269.0" />

    <Label layoutX="30.0" layoutY="328.0" text="Descripcion" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="328.0" />
    <TextArea fx:id="txtDescripcion" layoutX="30.0" layoutY="355.0" prefHeight="50.0" prefWidth="194.0" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="355.0" />

    <Label layoutX="31.0" layoutY="433.0" text="Duracion (meses)" AnchorPane.leftAnchor="31.0" AnchorPane.topAnchor="433.0" />
    <TextField fx:id="txtDuracionMeses" layoutX="30.0" layoutY="455.0" prefWidth="110.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="455.0" />

    <Label layoutX="158.0" layoutY="433.0" text="Valor mensual" AnchorPane.leftAnchor="158.0" AnchorPane.topAnchor="433.0" />
    <TextField fx:id="txtValorMensual" layoutX="160.0" layoutY="455.0" prefWidth="110.0" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="455.0" />

    <Label layoutX="28.0" layoutY="508.0" text="Tipo de plan" AnchorPane.leftAnchor="28.0" AnchorPane.topAnchor="508.0" />
    <ComboBox fx:id="cbTipoPlan" layoutX="30.0" layoutY="533.0" onAction="#handleCambioTipoPlan" prefWidth="110.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="533.0" />

    <Label layoutX="160.0" layoutY="508.0" text="Estado" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="508.0" />
    <ComboBox fx:id="cbEstado" layoutX="160.0" layoutY="533.0" prefWidth="110.0" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="533.0" />


    <AnchorPane fx:id="panelPersonalizado" managed="false" prefHeight="290.0" prefWidth="240.0" visible="false" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="446.0">

        <Label style="-fx-font-size: 13px; -fx-text-fill: #5f5e5a;" text="Datos del plan personalizado" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <Label text="Cantidad de sesiones" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="24.0" />
        <TextField fx:id="txtCantidadSesiones" prefWidth="240.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="46.0" />

        <Label text="Especialidad requerida" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="80.0" />
        <TextField fx:id="txtEspecialidadRequerida" prefWidth="240.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="102.0" />

        <Label text="Objetivos del cliente" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="136.0" />
        <TextArea fx:id="txtObjetivosCliente" prefHeight="50.0" prefWidth="240.0" wrapText="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="158.0" />

        <Label text="Entrenador asignado" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="216.0" />
        <ComboBox fx:id="cbEntrenadorAsignado" prefWidth="240.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="238.0" />

    </AnchorPane>

    <Label fx:id="lblMensajePlan" prefWidth="240.0" style="-fx-text-fill: #c0392b;" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="742.0" />

    <Button layoutX="32.0" layoutY="625.0" onAction="#handleRegistrarPlan" style="-fx-padding: 6 20;" text="Registrar " AnchorPane.leftAnchor="32.0" AnchorPane.topAnchor="625.0" />



    <Label layoutX="302.0" layoutY="144.0" style="-fx-font-size: 16px;" text="Lista de planes" AnchorPane.leftAnchor="302.0" AnchorPane.topAnchor="144.0" />

    <TableView fx:id="tablaPlanes" layoutX="302.0" layoutY="183.0" prefHeight="363.0" prefWidth="602.0" AnchorPane.bottomAnchor="213.0" AnchorPane.leftAnchor="302.0" AnchorPane.rightAnchor="43.0" AnchorPane.topAnchor="183.0">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80" text="Codigo" />
            <TableColumn fx:id="colNombre" prefWidth="140" text="Nombre" />
            <TableColumn fx:id="colTipo" prefWidth="100" text="Tipo" />
            <TableColumn fx:id="colDuracion" prefWidth="90" text="Duracion" />
            <TableColumn fx:id="colValor" prefWidth="100" text="Valor" />
            <TableColumn fx:id="colEstado" prefWidth="90" text="Estado" />
        </columns>
        <placeholder>
            <Label text="Tabla sin contenido" />
        </placeholder>
    </TableView>

</AnchorPane>
