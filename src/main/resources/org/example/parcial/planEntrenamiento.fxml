<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="860.0" prefWidth="947.0" style="-fx-background-color: #f2f2f0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial.viewController.PlanEntrenamientoViewController">


    <Button onAction="#handleRegresar" text="&lt;- Regresar" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0" />

    <!-- Titulo -->
    <Label style="-fx-font-size: 28px;" text="Gestionar planes de entrenamiento" AnchorPane.leftAnchor="27.0" AnchorPane.topAnchor="60.0">
        <font>
            <Font size="18.0" />
        </font>
    </Label>


    <Label text="Codigo" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="140.0" />
    <TextField fx:id="txtCodigo" prefHeight="25.0" prefWidth="240.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="162.0" />

    <Label text="Nombre" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="196.0" />
    <TextField fx:id="txtNombre" prefHeight="25.0" prefWidth="240.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="218.0" />

    <Label text="Descripcion" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="252.0" />
    <TextArea fx:id="txtDescripcion" prefHeight="50.0" prefWidth="240.0" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="274.0" />

    <Label text="Duracion (meses)" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="334.0" />
    <TextField fx:id="txtDuracionMeses" prefWidth="110.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="356.0" />

    <Label text="Valor mensual" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="334.0" />
    <TextField fx:id="txtValorMensual" prefWidth="110.0" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="356.0" />

    <Label text="Tipo de plan" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="392.0" />
    <ComboBox fx:id="cbTipoPlan" onAction="#handleCambioTipoPlan" prefWidth="110.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="414.0" />

    <Label text="Estado" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="392.0" />
    <ComboBox fx:id="cbEstado" prefWidth="110.0" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="414.0" />


    <AnchorPane fx:id="panelPersonalizado" managed="false" prefHeight="280.0" prefWidth="240.0" visible="false" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="452.0">

        <Label style="-fx-font-size: 13px; -fx-text-fill: #5f5e5a;" text="Datos del plan personalizado" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />

        <Label text="Cantidad de sesiones" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="24.0" />
        <TextField fx:id="txtCantidadSesiones" prefWidth="240.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="46.0" />

        <Label text="Especialidad requerida" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="80.0" />
        <TextField fx:id="txtEspecialidadRequerida" prefWidth="240.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="102.0" />

        <Label text="Objetivos del cliente" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="136.0" />
        <TextArea fx:id="txtObjetivosCliente" prefHeight="50.0" prefWidth="240.0" wrapText="true" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="158.0" />

        <Label text="Entrenador asignado" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="216.0" />
        <ComboBox fx:id="cbEntrenadorAsignado" prefWidth="240.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="238.0" />

    </AnchorPane>

    <Label fx:id="lblMensajePlan" prefWidth="240.0" style="-fx-text-fill: #c0392b;" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="742.0" />

    <Button layoutX="31.0" layoutY="521.0" onAction="#handleRegistrarPlan" style="-fx-padding: 6 20;" text="Registrar " AnchorPane.leftAnchor="31.0" AnchorPane.topAnchor="521.0" />



    <Label style="-fx-font-size: 16px;" text="Lista de planes" AnchorPane.leftAnchor="316.0" AnchorPane.topAnchor="147.0" />

    <TableView fx:id="tablaPlanes" prefHeight="640.0" prefWidth="588.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="316.0" AnchorPane.rightAnchor="43.0" AnchorPane.topAnchor="183.0">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80" text="Codigo" />
            <TableColumn fx:id="colNombre" prefWidth="140" text="Nombre" />
            <TableColumn fx:id="colTipo" prefWidth="100" text="Tipo" />
            <TableColumn fx:id="colDuracion" prefWidth="90" text="Duracion" />
            <TableColumn fx:id="colValor" prefWidth="100" text="Valor" />
            <TableColumn fx:id="colEstado" prefWidth="90" text="Estado" />
        </columns>
        <placeholder>
            <Label text="Tabla sin contenido" />
        </placeholder>
    </TableView>

</AnchorPane>
