<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0"
            prefWidth="870.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.parcial.viewController.InscripcionViewController">

    <children>

        <VBox layoutX="48.0"
              layoutY="29.0"
              prefWidth="772.0"
              spacing="20.0">

            <children>

                <!-- Espacio superior -->
                <VBox prefWidth="293.0"
                      spacing="6.0" />

                <!-- Botón regresar -->
                <Button mnemonicParsing="false"
                        prefHeight="40.0"
                        prefWidth="125.0"
                        style="-fx-background-color: white; -fx-border-color: #d0d0d0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"
                        text="←  Regresar"
                        onAction="#handleRegresar" />

                <!-- Título -->
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold;"
                       text="Gestionar inscripciones" />

                <HBox prefWidth="772.0"
                      spacing="45.0">

                    <children>

                        <!-- FORMULARIO -->
                        <VBox prefWidth="293.0"
                              spacing="7.0">

                            <children>

                                <!-- Cliente -->
                                <Label style="-fx-font-size: 14px;"
                                       text="Cliente" />

                                <ComboBox fx:id="cbCliente"
                                          prefHeight="43.0"
                                          prefWidth="293.0"
                                          promptText="Seleccionar cliente"
                                          style="-fx-font-size: 14px;" />

                                <VBox prefHeight="4.0" />

                                <!-- Plan -->
                                <Label style="-fx-font-size: 14px;"
                                       text="Plan de entrenamiento" />

                                <ComboBox fx:id="cbPlan"
                                          prefHeight="43.0"
                                          prefWidth="293.0"
                                          promptText="Seleccionar plan"
                                          style="-fx-font-size: 14px;" />

                                <VBox prefHeight="4.0" />

                                <!-- Fecha -->
                                <Label style="-fx-font-size: 14px;"
                                       text="Fecha de inscripción" />

                                <DatePicker fx:id="dpFechaInscripcion"
                                            prefHeight="43.0"
                                            prefWidth="293.0"
                                            promptText="dd/mm/aaaa"
                                            style="-fx-font-size: 14px;" />

                                <!-- Servicios adicionales -->
                                <Label style="-fx-font-size: 14px;"
                                       text="Servicios adicionales" />

                                <ComboBox fx:id="cbServicio"
                                          prefHeight="40.0"
                                          prefWidth="293.0"
                                          promptText="Seleccionar servicio"
                                          style="-fx-font-size: 14px;" />

                            </children>

                        </VBox>

                        <!-- TABLA -->
                        <VBox prefHeight="337.0"
                              prefWidth="465.0"
                              spacing="8.0">

                            <children>

                                <Label style="-fx-font-size: 18px;"
                                       text="Lista de inscripciones" />

                                <TableView fx:id="tablaInscripciones"
                                           prefHeight="301.0"
                                           prefWidth="481.0"
                                           style="-fx-border-color: #dddddd; -fx-border-radius: 8; -fx-background-radius: 8;">

                                    <columns>

                                        <TableColumn fx:id="colCliente"
                                                     prefWidth="87.0"
                                                     text="Cliente" />

                                        <TableColumn fx:id="colPlan"
                                                     prefWidth="86.0"
                                                     text="Plan" />

                                        <TableColumn fx:id="colFecha"
                                                     prefWidth="86.0"
                                                     text="Fecha" />

                                        <TableColumn fx:id="colServicios"
                                                     prefWidth="116.0"
                                                     text="Servicios" />

                                        <TableColumn fx:id="colTotal"
                                                     prefWidth="76.0"
                                                     text="Total" />

                                    </columns>

                                </TableView>

                            </children>

                        </VBox>

                    </children>

                </HBox>

            </children>

        </VBox>

        <!-- Botón registrar -->
        <Button layoutX="48.0"
                layoutY="533.0"
                mnemonicParsing="false"
                prefHeight="40.0"
                prefWidth="125.0"
                text="Registrar Inscripcion"
                onAction="#handleRegistrarInscripcion" />

    </children>

</AnchorPane>