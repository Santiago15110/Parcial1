<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="870.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">

    <children>
        <VBox layoutX="48.0" layoutY="29.0" prefWidth="772.0" spacing="20.0">

            <children>

                <!-- Botón regresar -->
                
                <!-- SERVICIOS ADICIONALES -->
                <VBox prefWidth="293.0" spacing="6.0" />


                <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="125.0" style="-fx-background-color: white; -fx-border-color: #d0d0d0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;" text="←  Regresar" />

                <!-- Título -->
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Gestionar inscripciones" />

                <!-- Contenido -->
                <HBox prefWidth="772.0" spacing="45.0">

                    <!-- Formulario -->
                    <VBox prefWidth="293.0" spacing="7.0">

                        <children>

                            <Label style="-fx-font-size: 14px;" text="Cliente" />

                            <ComboBox prefHeight="43.0" prefWidth="293.0" promptText="Seleccionar cliente" style="-fx-font-size: 14px;" />

                            <VBox prefHeight="4.0" />

                            <Label style="-fx-font-size: 14px;" text="Plan de entrenamiento" />

                            <ComboBox prefHeight="43.0" prefWidth="293.0" promptText="Seleccionar plan" style="-fx-font-size: 14px;" />

                            <VBox prefHeight="4.0" />

                            <Label style="-fx-font-size: 14px;" text="Fecha de inscripción" />

                            <DatePicker prefHeight="43.0" prefWidth="293.0" promptText="dd/mm/aaaa" style="-fx-font-size: 14px;" />
                           <Label style="-fx-font-size: 14px;" text="Servicios adicionales" />
               
                           <ComboBox prefHeight="40.0" prefWidth="293.0" promptText="Seleccionar servicio" style="-fx-font-size: 14px;" />

                        </children>
                    </VBox>

                    <!-- Tabla -->
                    <VBox prefHeight="337.0" prefWidth="465.0" spacing="8.0">

                        <children>

                            <Label style="-fx-font-size: 18px;" text="Lista de inscripciones" />

                            <TableView prefHeight="301.0" prefWidth="481.0" style="-fx-border-color: #dddddd; -fx-border-radius: 8; -fx-background-radius: 8;">

                                <columns>

                                    <TableColumn prefWidth="87.0" text="Cliente" />

                                    <TableColumn prefWidth="86.0" text="Plan" />

                                    <TableColumn prefWidth="86.0" text="Fecha" />

                                    <TableColumn prefWidth="116.0" text="Servicios" />

                                    <TableColumn prefWidth="76.0" text="Total" />

                                </columns>

                            </TableView>

                        </children>
                    </VBox>

                </HBox>

            </children>

        </VBox>
      <Button layoutX="48.0" layoutY="533.0" mnemonicParsing="false" prefHeight="40.0" prefWidth="125.0" text="Registrar Inscripcion" />
    </children>

</AnchorPane>
