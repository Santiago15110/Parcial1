<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="870.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial.viewController.InscripcionViewController">

    <children>
        <VBox layoutX="29.0" layoutY="4.0" prefHeight="678.0" prefWidth="791.0" spacing="20.0">

            <children>

                <!-- Botón regresar -->
                <VBox prefWidth="293.0" spacing="6.0" />
                <Button mnemonicParsing="false" onAction="#handleRegresar" prefHeight="26.0" prefWidth="103.0" text="Regresar" />

                <!-- Título -->
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold;" text="Gestionar inscripciones" />

                <!-- Contenido -->
                <HBox prefWidth="772.0" spacing="45.0">

                    <!-- Formulario -->
                    <VBox prefWidth="293.0" spacing="7.0">

                        <children>

                            <Label style="-fx-font-size: 14px;" text="Cliente" />
                            <ComboBox fx:id="cbCliente" prefHeight="43.0" prefWidth="293.0" promptText="Seleccionar cliente" style="-fx-font-size: 14px;" />

                            <VBox prefHeight="4.0" />

                            <Label style="-fx-font-size: 14px;" text="Plan de entrenamiento" />
                            <ComboBox fx:id="cbPlan" prefHeight="43.0" prefWidth="293.0" promptText="Seleccionar plan" style="-fx-font-size: 14px;" />

                            <VBox prefHeight="4.0" />

                            <Label style="-fx-font-size: 14px;" text="Fecha de inicio" />
                            <DatePicker fx:id="dpFechaInicio" prefHeight="43.0" prefWidth="293.0" promptText="dd/mm/aaaa" style="-fx-font-size: 14px;" />

                            <Label style="-fx-font-size: 14px;" text="Fecha Final" />
                            <DatePicker fx:id="dpFechaFin" disable="true" prefHeight="43.0" prefWidth="293.0" promptText="dd/mm/aaaa" style="-fx-font-size: 14px;" />

                            <Label style="-fx-font-size: 14px;" text="Servicios adicionales" />
                            <ComboBox fx:id="cbServicio" prefHeight="40.0" prefWidth="203.0" promptText="Seleccionar servicio" style="-fx-font-size: 14px;" />

                            <Label fx:id="lblMensajeInscripcion" wrapText="true" style="-fx-text-fill: #c0392b; -fx-font-size: 12px;" />

                            <Button mnemonicParsing="false" onAction="#handleRegistrarInscripcion" prefHeight="40.0" prefWidth="180.0" text="Registrar Inscripcion" />

                        </children>
                    </VBox>

                    <!-- Tabla -->
                    <VBox prefHeight="337.0" prefWidth="634.0" spacing="8.0">

                        <children>

                            <Label style="-fx-font-size: 18px;" text="Lista de inscripciones" />

                            <TableView fx:id="tablaInscripciones" prefHeight="301.0" prefWidth="545.0" style="-fx-border-color: #dddddd; -fx-border-radius: 8; -fx-background-radius: 8;">

                                <columns>
                                    <TableColumn fx:id="colCliente" prefWidth="87.0" text="Cliente" />
                                    <TableColumn fx:id="colPlan" prefWidth="86.0" text="Plan" />
                                    <TableColumn fx:id="colFechaInicio" prefWidth="86.0" text="Fecha Inicio" />
                                    <TableColumn fx:id="colFechaFin" prefWidth="95.33331298828125" text="Fecha final" />
                                    <TableColumn fx:id="colServicios" prefWidth="96.66668701171875" text="Servicios" />
                                    <TableColumn fx:id="colTotal" prefWidth="86.0" text="Total" />
                                </columns>

                            </TableView>

                        </children>
                    </VBox>

                </HBox>

            </children>

        </VBox>
    </children>

</AnchorPane>