<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="525.0" prefWidth="956.0" style="-fx-background-color: #f2f2f0;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.parcial.controller.ServicioAdicionalController">


    <Button onAction="#handleRegresar" text="&lt;- Regresar" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="14.0" />


    <Label style="-fx-font-size: 26px;" text="Gestionar servicios adicionales" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="60.0" />



    <Label text="Codigo" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="140.0" />
    <TextField fx:id="txtCodigo" prefWidth="240.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="162.0" />

    <Label text="Nombre" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="196.0" />
    <TextField fx:id="txtNombre" prefWidth="240.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="218.0" />

    <Label text="Descripcion" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="252.0" />
    <TextArea fx:id="txtDescripcion" prefHeight="50.0" prefWidth="240.0" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="274.0" />

    <Label text="Precio" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="334.0" />
    <TextField fx:id="txtPrecio" prefWidth="110.0" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="356.0" />

    <Label text="Disponibilidad" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="334.0" />
    <ComboBox fx:id="cbDisponibilidad" prefWidth="110.0" AnchorPane.leftAnchor="160.0" AnchorPane.topAnchor="356.0" />

    <Label fx:id="lblMensajeServicio" prefWidth="240.0" style="-fx-text-fill: #c0392b;" wrapText="true" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="392.0" />

    <Button layoutX="27.0" layoutY="439.0" onAction="#handleRegistrarServicio" style="-fx-padding: 6 20;" text="Registrar servicio" AnchorPane.leftAnchor="27.0" AnchorPane.topAnchor="439.0" />



    <Label style="-fx-font-size: 16px;" text="Lista de servicios" AnchorPane.leftAnchor="310.0" AnchorPane.topAnchor="108.0" />

    <TableView fx:id="tablaServicios" prefHeight="510.0" prefWidth="646.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="310.0" AnchorPane.rightAnchor="41.0" AnchorPane.topAnchor="140.0">
        <columns>
            <TableColumn fx:id="colCodigo" prefWidth="80" text="Codigo" />
            <TableColumn fx:id="colNombre" prefWidth="140" text="Nombre" />
            <TableColumn fx:id="colDescripcion" prefWidth="180" text="Descripcion" />
            <TableColumn fx:id="colPrecio" prefWidth="100" text="Precio" />
            <TableColumn fx:id="colDisponibilidad" prefWidth="110" text="Disponibilidad" />
        </columns>
        <placeholder>
            <Label text="Tabla sin contenido" />
        </placeholder>
    </TableView>

</AnchorPane>
