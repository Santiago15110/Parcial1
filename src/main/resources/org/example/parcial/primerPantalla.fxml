<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.parcial.viewController.PrimerPantallaViewController"
            prefHeight="600.0" prefWidth="750.0">

    <Label text="Gimnasio Luxury"
           style="-fx-font-size: 36px; -fx-font-weight: bold;"
           layoutX="200.0" layoutY="60.0" />

    <VBox spacing="1"
          layoutX="285.0" layoutY="200.0"
          prefWidth="300.0">

        <Button text="Gestion de los clientes"
                onAction="#irGestionClientes"
                prefWidth="300.0" prefHeight="40.0" />

        <Button text="Gestion de los entrenadores"
                onAction="#irGestionEntrenadores"
                prefWidth="300.0" prefHeight="40.0" />

        <Button text="Gestionar planes de entrenamiento"
                onAction="#irGestionPlanes"
                prefWidth="300.0" prefHeight="40.0" />

        <Button text="Gestion de los servicios adicionales"
                onAction="#irGestionServicios"
                prefWidth="300.0" prefHeight="40.0" />

        <Button text="Inscripcion"
                onAction="#irGestionInscripciones"
                prefWidth="300.0" prefHeight="40.0" />

    </VBox>

</AnchorPane>